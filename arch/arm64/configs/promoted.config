# Targeted promotion of problem modules to built-in, for redfin.
#
# Merged after redbull_defconfig and halium.config:
#     make redbull_defconfig halium.config promoted.config
#
# Rationale: on this tree a module whose init_module returns an error is freed
# by the kernel, but free_module() does not unregister platform drivers. The bus
# driver klist then holds a pointer into freed memory and the next
# bus_for_each_drv walk oopses at __device_attach_driver+0x14. Confirmed for
# peripheral-loader (-EPROBE_DEFER, "Unknown error 517") and usb-audio-qmi
# (-EAFNOSUPPORT); msm_minidump additionally fails -ENODEV and takes
# watchdog_v2, msm-poweroff, diagchar, dcc_v2, memory_dump_v2, system_pm and
# msm_pm down with it, none of which have ever loaded on this port.
#
# Built in, there is no module to free, -EPROBE_DEFER is retried by the
# deferred-probe machinery as intended, and a failing initcall no longer
# poisons the driver list or its dependents.
#
# This is deliberately NOT the all-yes builtin.config in this directory: that
# flips all 197 modules and, while it links, it panic-reboots before the initrd.
# Here only the drivers that actually misbehave are promoted, plus the
# transitive dependency closure they need (a built-in cannot reference a
# module). Closure computed from modules.dep - 30 modules, 26 symbols.

# The misbehaving drivers themselves
CONFIG_MSM_PIL=y
CONFIG_MSM_PIL_SSR_GENERIC=y
CONFIG_SND_USB_AUDIO_QMI=y
CONFIG_QCOM_MINIDUMP=y
CONFIG_MEM_SHARE_QMI_SERVICE=y
CONFIG_QCOM_KGSL=y
CONFIG_MSM_VIDC_V4L2=y
CONFIG_QTI_QMI_SENSOR=y
CONFIG_QTI_QMI_COOLING_DEVICE=y
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y

# Dependency closure required to build the above in
CONFIG_MSM_SUBSYSTEM_RESTART=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_SECURE_BUFFER=y
CONFIG_QTEE_SHM_BRIDGE=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_IPC_LOGGING=y
CONFIG_QCOM_BUS_SCALING=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_LAZY_MAPPING=y
CONFIG_QCOM_SECURE_BUFFER=y
CONFIG_ION=y
CONFIG_RPMSG=y
CONFIG_MSM_FASTCVPD=y
CONFIG_QCOM_DEVFREQ_DEVBW=y

# Kconfig "depends on" prerequisites. These never appear in modules.dep - that
# records runtime symbol dependencies, whereas Kconfig dependencies are a
# separate, build-time graph - but a symbol cannot be =y while something it
# depends on is =m, so oldconfig silently downgrades it back.
#   QRTR        <- QCOM_QMI_HELPERS <- MEM_SHARE_QMI_SERVICE, QTI_QMI_SENSOR,
#                  QTI_QMI_COOLING_DEVICE, SND_USB_AUDIO_QMI
#   QCOM_QFPROM <- QCOM_KGSL <- DEVFREQ_GOV_QCOM_ADRENO_TZ <- ..._GPUBW_MON
#   MAILBOX     <- QCOM_SMEM_STATE
#   QCOM_GLINK  <- MSM_FASTCVPD
CONFIG_QRTR=y
CONFIG_QCOM_QFPROM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_GLINK=y

# RPMSG and QCOM_SMEM_STATE are "tristate" with no prompt - select-only symbols
# that take the value of whatever selects them, so setting them directly does
# nothing. Promote the selectors instead.
#   QCOM_SMP2P            selects QCOM_SMEM_STATE
#   RPMSG_QCOM_GLINK_*    select RPMSG, which QCOM_GLINK <- MSM_FASTCVPD needs
CONFIG_QCOM_SMP2P=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_GLINK_NATIVE=y
CONFIG_RPMSG_CHAR=y

# glink_probe is built in as part of the closure and calls
# qcom_glink_spss_register(), so its provider has to come along too.
CONFIG_RPMSG_QCOM_GLINK_SPSS=y
