# All-builtin config fragment for redfin.
#
# Merged after redbull_defconfig and halium.config:
#     make redbull_defconfig halium.config builtin.config
#
# WHY: on this tree a module whose init_module returns an error gets freed by
# the kernel, but free_module() does not unregister platform drivers. The bus
# driver klist is left holding a pointer into freed module memory, and the next
# bus_for_each_drv walk oopses at __device_attach_driver+0x14. Observed with
# peripheral-loader (-EPROBE_DEFER, "Unknown error 517") and usb-audio-qmi
# (-EAFNOSUPPORT). When the walker happens to be deferred_probe_work_func the
# deferred-probe worker dies and everything still pending is abandoned - which
# is how a600000.ssusb ended up never probing, leaving no dwc3 and no UDC.
#
# A built-in driver has no module to free. -EPROBE_DEFER from a built-in
# initcall is recorded and retried by the deferred-probe machinery as intended,
# and a failing initcall cannot take its dependents down with it - msm_minidump
# failing -ENODEV currently blocks watchdog_v2, msm-poweroff, diagchar, dcc_v2,
# memory_dump_v2, system_pm and msm_pm from ever loading.
#
# Generated from the =m entries of redbull_defconfig.
CONFIG_IKHEADERS=y
#
# Kept as modules on purpose:
#   CONFIG_QCA_CLD_WLAN  - qcacld-3.0, a very large staging driver written to be
#                          a module; not needed to boot, and the usual source of
#                          LTO link blowups.
#   CONFIG_GOOGLE_WLAN_MAC - goes with it.
#   CONFIG_IKHEADERS     - would embed a kheaders tarball in the image for no
#                          benefit here.
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_BRIDGE_NF_EBTABLES=y
CONFIG_BRIDGE_EBT_BROUTE=y
