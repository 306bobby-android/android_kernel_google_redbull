# Kernel config fragment for Halium / Ubuntu Touch on redbull (Pixel 5 / 4a 5G).
#
# Merged on top of redbull_defconfig:
#     make redbull_defconfig halium.config
#
# RULE: this fragment must NOT turn any driver that redbull_defconfig builds as
# a module (=m) into a built-in (=y).  The vendor_boot ramdisk ships the exact
# set of .ko files listed in modules.load and the Halium initrd modprobes them
# from there; flipping a driver to =y makes its .ko disappear from the build and
# silently drops it (and everything that depends on it) out of the ramdisk.
# Only add options that are absent or disabled in redbull_defconfig.

#
# Required by the Halium initrd itself
#
# /init mounts devtmpfs on /dev before anything else - without this the initrd
# dies immediately and the device hangs on the bootloader splash.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# open_by_handle_at(), used by systemd/udev in the rootfs
CONFIG_FHANDLE=y

# Virtual terminals: console=tty0 on the kernel cmdline, and Lomiri/Mir VT
# handling in the rootfs
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

#
# Containers - LXC is used to run the Android side
#
CONFIG_SYSVIPC=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

#
# AppArmor - required for application confinement in Ubuntu Touch.
#
# This tree carries the ordered-LSM infrastructure (CONFIG_LSM), where only the
# first "legacy major" LSM in the list is activated.  Put apparmor ahead of
# selinux so AppArmor is the active one; the Android container runs with
# SELinux permissive under Halium.
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux,bpf"

#
# USB gadget: RNDIS for the initrd debug shell (scripts/panic/telnet)
#
# redbull_defconfig only enables NCM built-in and the Qualcomm GSI function as a
# module (usb_f_gsi.ko).  The panic/telnet script creates rndis.usb0, so build
# the generic RNDIS function in - it has to work before modules are available.
CONFIG_USB_CONFIGFS_RNDIS=y

#
# Bluetooth: virtual HCI, for bluebinder.
#
# Halium routes the host BlueZ stack to Android's binder Bluetooth HAL through
# bluebinder, which opens /dev/vhci and feeds HCI over it. redbull_defconfig
# enables Bluetooth but not the virtual-HCI driver, so /dev/vhci never exists
# and bluebinder crash-loops with:
#   Failed to open /dev/vhci device  Unable to open virtual device
# BlueZ then has no controller (no hci0), discovery finds nothing, and the
# Bluetooth toggle flips itself back off. Build the driver in so it is up
# before any module loads.
#
# IMPORTANT: keep config-symbol literals like BT (with an =y) out of the
# comment text above. merge_config.sh scans every line for CONFIG_ tokens, and
# a commented "...=y" gets parsed as a redefinition - an earlier version of
# this comment silently disabled Bluetooth entirely.
CONFIG_BT_HCIVHCI=y

#
# squashfs: required for snaps.
#
# Every snap is a squashfs image that snapd loop-mounts under /snap. The
# defconfig leaves squashfs off entirely, so snapd can set up the loop device
# (loop support is already enabled) and then fail at the mount, and nothing
# under /snap works.
#
# Enable the decompressors Ubuntu actually ships snaps with - xz for most of
# them, lzo for ones built for mount speed, and zstd for newer ones - plus zlib
# and lz4 so an unexpected image still mounts. Extended attributes are needed
# because snap contents carry security labels.
#
# IMPORTANT: as with the Bluetooth note above, keep config-symbol literals out
# of comment text - merge_config.sh parses commented lines too.
#
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
