# Kernel config fragment for Halium / Ubuntu Touch on redbull (Pixel 5 / 4a 5G).

#
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# open_by_handle_at(), used by systemd/udev in the rootfs
CONFIG_FHANDLE=y

# Virtual terminals: console=tty0 on the kernel cmdline, and Lomiri/Mir VT
# handling in the rootfs
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

#
CONFIG_SYSVIPC=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

#
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux,bpf"

# Early telnet debug daemon and panic log capture script.
CONFIG_USB_CONFIGFS_RNDIS=y
